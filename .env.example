TG_TOKEN=
TG_CHAT=
FIREBASE_DB_URL=
FIREBASE_SERVICE_ACCOUNT=
RENDER_EXTERNAL_URL=

# Generate offline and never commit/share this value.
MASTER_MNEMONIC=
MASTER_PASSPHRASE=

# ── Deposit detection (v6: FREE public RPC nodes, no Etherscan key needed) ──
# Each chain already has 2-3 free fallback RPCs baked into deposit-engine.js
# (publicnode.com first, then others) — if one goes down the engine
# auto-switches and logs a warning. You only need to set these if you want
# your own/paid RPC instead. Comma-separate for your own fallback list:
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com,https://rpc.ankr.com/eth
# BSC_RPC_URL=https://bsc-rpc.publicnode.com,https://bsc-dataseed.binance.org/
# POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com,https://polygon-rpc.com
# AVALANCHE_RPC_URL=https://avalanche-c-chain-rpc.publicnode.com,https://api.avax.network/ext/bc/C/rpc

# TronGrid free key (optional but recommended — without it TRON/USDT-TRC20
# polling still works, just on TronGrid's shared public rate limit).
# Get one free at https://www.trongrid.io/
TRONGRID_API_KEY=

SOLANA_RPC=https://api.mainnet-beta.solana.com
DEPOSIT_MIN_CONFIRMATIONS=3
DEPOSIT_POLL_MS=60000
# How many blocks max to scan per poll cycle per chain (safety cap after downtime).
DEPOSIT_MAX_BLOCK_SPAN=3000

# Any random string. Set this to enable GET /api/debug/status and
# POST /api/debug/poll-now?key=THIS_VALUE for live debugging without
# waiting for logs. Leave blank to keep those endpoints disabled.
DEBUG_ADMIN_KEY=

# ── NOTE on ETHERSCAN_API_KEY ──
# No longer used by deposit-engine.js. Etherscan removed free-tier access to
# BNB Chain / Avalanche / Base / OP in Nov 2025 (paid plans start at $49/mo),
# and BscScan's standalone free API was fully deprecated in Dec 2025. This
# backend now talks directly to each chain's own free public RPC node
# instead, so no Etherscan key is required at all.
# ETHERSCAN_API_KEY=
